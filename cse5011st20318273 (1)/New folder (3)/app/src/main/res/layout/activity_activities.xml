<?xml version="1.0" encoding="utf-8"?>
<!-- DILHAN'S UNIQUE BUTTON GRID LAYOUT -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏔️ Adventure Activities"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/eco_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- ACTIVITY BUTTONS GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/hikingButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🥾 Mountain\nHiking"
                android:backgroundTint="@color/eco_primary"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/climbingButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🧗 Rock\nClimbing"
                android:backgroundTint="@color/eco_secondary"
                android:textColor="@color/white"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/campingButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🏕️ Wilderness\nCamping"
                android:backgroundTint="@color/eco_accent"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/survivalButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🎯 Survival\nTraining"
                android:backgroundTint="@color/eco_tertiary"
                android:textColor="@color/white"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/expeditionButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="⛰️ Peak\nExpedition"
                android:backgroundTint="@color/eco_primary_dark"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/weatherButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🌩️ Storm\nWatching"
                android:backgroundTint="@color/accent_orange"
                android:textColor="@color/white"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- SINGLE WIDE BUTTON -->
        <Button
            android:id="@+id/allActivitiesButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📋 View All Adventure Activities"
            android:backgroundTint="@color/gray_600"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
