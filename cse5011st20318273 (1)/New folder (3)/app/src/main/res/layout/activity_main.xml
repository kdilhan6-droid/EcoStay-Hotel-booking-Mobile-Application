<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/eco_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:backgroundTint="@color/accent_orange"
        android:padding="32dp"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏔️"
            android:textSize="60sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EcoStay Retreat"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mountain Eco Adventures"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Simple Button Layout -->
    <Button
        android:id="@+id/roomsButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="🏠 Eco Rooms"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/eco_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/activitiesButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="🥾 Adventures"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/eco_secondary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/natureReservesButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="🌿 Nature Reserves"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/eco_tertiary"
        android:textColor="@color/white"
        android:layout_marginBottom="32dp" />

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/notificationsButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="📱 Alerts"
            android:backgroundTint="@color/eco_accent"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="👤 Profile"
            android:backgroundTint="@color/eco_primary_dark"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- LOGOUT BUTTON - PROMINENT -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🚪 SIGN OUT"
        android:backgroundTint="@color/eco_error"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp" />

    <!-- Developer Credit -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Developed by Dilhan Fernando"
        android:textColor="@color/gray_600"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginTop="24dp"
        android:fontFamily="serif"
        android:textStyle="italic" />

</LinearLayout>
