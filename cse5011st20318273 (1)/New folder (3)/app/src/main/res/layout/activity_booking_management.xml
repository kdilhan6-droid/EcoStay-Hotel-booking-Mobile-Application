<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eco_primary"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 My Bookings"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage your eco-friendly stays"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bookings List -->
    <ListView
        android:id="@+id/list_bookings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:divider="@color/light_gray"
        android:dividerHeight="1dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="64sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Bookings Yet"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start your eco-friendly journey by booking your first sustainable stay!"
            android:textSize="16sp"
            android:textColor="@color/medium_gray"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="32dp" />

        <Button
            android:id="@+id/btn_browse_rooms"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse Eco Rooms"
            android:backgroundTint="@color/eco_primary"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
