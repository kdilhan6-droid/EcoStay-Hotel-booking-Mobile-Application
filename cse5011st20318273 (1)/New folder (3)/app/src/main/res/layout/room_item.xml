<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/white"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Room Image Placeholder -->
    <ImageView
        android:id="@+id/roomImage"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:background="@color/accent_orange"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <!-- Room Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/roomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eco Suite Deluxe"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/eco_primary" />

        <TextView
            android:id="@+id/roomPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$120/night"
            android:textSize="14sp"
            android:textColor="@color/eco_accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roomFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solar-powered, Organic amenities"
            android:textSize="12sp"
            android:textColor="@color/eco_secondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Eco Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿 ECO"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:background="@color/eco_primary"
        android:padding="4dp"
        android:layout_gravity="top" />

</LinearLayout>
